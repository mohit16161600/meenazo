# ── Razorpay online payments ────────────────────────────────────
# Keys from https://dashboard.razorpay.com (test: rzp_test_… / live: rzp_live_…).
# Leave blank to keep only Cash on Delivery. NEXT_PUBLIC_ one = same as KEY_ID.
#
# ⚠️ THESE ARE **LIVE** KEYS — every payment made on this machine is REAL money
# off a real card/UPI. For everyday local testing paste your rzp_test_… pair
# here instead (Razorpay dashboard → Settings → API keys → Test mode); test
# payments behave identically but move nothing.
RAZORPAY_KEY_ID=rzp_live_zsA5fkSar5cFlv
RAZORPAY_KEY_SECRET=9ZiT8bmzEr4CiYbpk8V9KDLS
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_zsA5fkSar5cFlv
# Secret typed into Razorpay → Settings → Webhooks for the URL
#   https://<domain>/api/razorpay/webhook
# It confirms a paid order even if the customer closes the tab mid-payment.
# Any long random string — it must match on both sides.
RAZORPAY_WEBHOOK_SECRET=meenazo-rzp-webhook-dev-secret-change-me

