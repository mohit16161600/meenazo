# COD orders now use the same-origin Next.js route /api/cod (no PHP/CORS).
# Leave NEXT_PUBLIC_COD_API unset to use the default "/api/cod".

# ── Public site URL (REQUIRED) ──────────────────────────────────
# Used for canonical URLs, sitemap.xml, robots.txt and OG tags. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://meenazo.com

# ── Panel / store database (REQUIRED) ───────────────────────────
# This is the database the ADMIN PANEL, customer accounts and ORDERS live in.
# Without it the app falls back to localhost/root/no-password and nothing works.
PANEL_DB_HOST=127.0.0.1
PANEL_DB_PORT=3306
PANEL_DB_USER=your_panel_db_user
PANEL_DB_PASSWORD=your_panel_db_password
PANEL_DB_NAME=meenazo_panel

# ── Session signing secrets (REQUIRED) ──────────────────────────
# Both admin and customer logins are signed cookies. In production the app
# REFUSES to sign a session when these are blank (it would be forgeable), so
# leaving them empty means nobody can log in. Generate strong random values:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PANEL_SESSION_SECRET=
# Optional — falls back to PANEL_SESSION_SECRET when blank.
CUSTOMER_SESSION_SECRET=

# First-boot key for /api/panel/setup. The installer normally requires a signed-in
# ADMIN, but on a brand-new database there is no admin to sign in as yet — this
# token is the only other way in. Set it, run setup once, then DELETE the line.
# Leaving it blank closes that path entirely (admins can still re-run setup).
#   curl -X POST https://your-domain/api/panel/setup -H "x-setup-token: <value>"
PANEL_SETUP_TOKEN=

# CRM MySQL connection — fill with your real live-server DB credentials.
CRM_DB_HOST=127.0.0.1
CRM_DB_PORT=3306
CRM_DB_USER=meenazoin_crm
CRM_DB_PASSWORD=your_db_password
CRM_DB_NAME=your_db_name

# ── Razorpay online payments ────────────────────────────────────
# Keys from https://dashboard.razorpay.com (test: rzp_test_… / live: rzp_live_…).
# Leave blank to keep only Cash on Delivery. NEXT_PUBLIC_ one = same as KEY_ID.
# Every method enabled on your Razorpay account (UPI, cards, netbanking,
# wallets, EMI, pay-later) is offered at checkout — no code change needed.
# NEXT_PUBLIC_* is baked in at BUILD time: change it, then rebuild.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay → Settings → Webhooks. Add https://<domain>/api/razorpay/webhook
# with this same secret and the events payment.captured, payment.failed,
# order.paid, refund.processed. WITHOUT it a customer who pays and closes the
# tab before the page returns leaves a PAID order sitting as "pending".
RAZORPAY_WEBHOOK_SECRET=

# ── Customer accounts / OTP + order confirmation (WhatsApp via AiSensy) ──
# WhatsApp OTP goes out through the AiSensy campaign below. Fill AISENSY_API_KEY
# from your AiSensy dashboard; SENDER_NAME must match the account display name.
AISENSY_API_KEY=
AISENSY_CAMPAIGN_NAME=meenazo_authentication_code
AISENSY_SENDER_NAME=
# Order confirmation template — body params in this exact order:
#   {{1}} first name · {{2}} order id · {{3}} product · {{4}} amount · {{5}} payment
AISENSY_ORDER_CAMPAIGN=meenazo_order_confirm
# Optional legacy fallbacks (leave blank to use AiSensy only).
SMS_SEND_URL=
SMS_API_KEY=
WHATSAPP_SEND_URL=
WHATSAPP_API_KEY=

# ── Default admin (seeded ONCE into the DB on first setup) ──
# Set BOTH before the first /panel/setup run. If PANEL_ADMIN_PASSWORD is left
# blank in production a strong random password is generated and shown once in
# the setup response — save it there and then, it is not recoverable later.
PANEL_ADMIN_EMAIL=
PANEL_ADMIN_PASSWORD=

# ── EasyEcom fulfillment (orders push here after the hold window) ──
# Orders are pushed to EasyEcom as retail orders (keyed by product SKU)
# EASYECOM_HOLD_HOURS after being placed. Fill URL + token to enable; leave
# blank to keep orders queued locally. Confirm the account-level ids below with
# your EasyEcom account (marketplace, payment mode, shipping method, carrier).
#
# URL = <your account's API host>/webhook/v2/createOrder  — the "Retail Order
# (B2C)" endpoint. NOT /orders/V2/createOrder (that path 404s). The host must
# be the one that issued your token: decode the JWT and use its `iss` host
# (e.g. loadbalancer-m.easyecom.io), or a token from another host gets 401/403.
# Paste the VALUE only — not "EASYECOM_API_URL=https://…".
EASYECOM_API_URL=
EASYECOM_API_TOKEN=
EASYECOM_HOLD_HOURS=3
EASYECOM_MARKETPLACE_ID=10
EASYECOM_PAYMENT_MODE_COD=2
EASYECOM_PAYMENT_MODE_PREPAID=1
EASYECOM_SHIPPING_METHOD=1
EASYECOM_CARRIER_ID=
EASYECOM_IS_MARKET_SHIPPED=0
# Secret for the headless cron trigger: POST /api/easyecom/dispatch?secret=...
EASYECOM_DISPATCH_SECRET=
# Secret EasyEcom must include when calling the status webhook:
# https://<domain>/api/easyecom/webhook?secret=...  (or x-webhook-secret header)
EASYECOM_WEBHOOK_SECRET=
