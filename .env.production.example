# ── EasyEcom fulfillment (orders push here after the hold window) ──
# Orders no longer create CRM enquiry leads — they are pushed to EasyEcom as
# retail orders (keyed by product SKU) EASYECOM_HOLD_HOURS after being placed.
# Fill the endpoint URL + token from your EasyEcom account to enable pushing;
# leave blank and orders just stay queued (visible in the panel) until set.
# DELIBERATELY BLANK ON THIS MACHINE. The local DB holds test orders; if this
# points at the live API, the 10-minute dispatch cron pushes them into the REAL
# EasyEcom account the moment any product gets a SKU (real shipments!). Blank =
# orders just queue locally. The SERVER value lives in .env.production.local:
#   EASYECOM_API_URL=https://loadbalancer-m.easyecom.io/orders/V2/createOrder
EASYECOM_API_URL=https://loadbalancer-m.easyecom.io/orders/V2/createOrder
EASYECOM_API_TOKEN=eyJ0eXAiOiJKV1QiLCJhbGciOiJIUzI1NiJ9..Vmp66PSUATzJkqozy6HMqTvcW2iZUU-N7pTpjAEVYko
EASYECOM_HOLD_HOURS=3
EASYECOM_MARKETPLACE_ID=10
EASYECOM_PAYMENT_MODE_COD=2
EASYECOM_PAYMENT_MODE_PREPAID=1
EASYECOM_SHIPPING_METHOD=1
EASYECOM_CARRIER_ID=
EASYECOM_IS_MARKET_SHIPPED=0
# Secret for the headless cron trigger: POST /api/easyecom/dispatch?secret=...
EASYECOM_DISPATCH_SECRET=meenazo-dispatch-dev-secret-change-me
# Secret EasyEcom must include when calling the status webhook:
# https://<domain>/api/easyecom/webhook?secret=...  (or x-webhook-secret header)
EASYECOM_WEBHOOK_SECRET=meenazo-webhook-dev-secret-change-me
